# ============================================================
# ContaNova ERP — Variables de Entorno
# Copia este archivo como .env en la raíz del proyecto
# y completa los valores reales.
# ============================================================

# ─── Base de Datos ─────────────────────────────────────────
# URL de conexión PostgreSQL (Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/DBNAME

# ─── API Server ────────────────────────────────────────────
# Puerto donde corre el backend (Render lo asigna como $PORT)
PORT=8080

# Orígenes permitidos para CORS separados por coma
# En desarrollo: http://localhost:5173
# En producción: https://menpoe-contanova.web.app
CORS_ORIGIN=http://localhost:5173

# ─── Entorno ────────────────────────────────────────────────
NODE_ENV=development

# ─── Frontend (Vite) ────────────────────────────────────────
# URL completa del API backend (solo si no usas el proxy local)
# En producción con Render: https://contanova-api.onrender.com
VITE_API_URL=http://localhost:8080

# Servidor WhatsApp Baileys (proceso persistente; local o Render)
# Local: http://localhost:8090
# Producción: https://contanova-whatsapp.onrender.com
VITE_WHATSAPP_URL=http://localhost:8090

# Delays anti-ban del gateway WhatsApp (ms)
WA_DELAY_MIN_MS=4000
WA_DELAY_MAX_MS=9000
