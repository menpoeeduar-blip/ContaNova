{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "pnpm --filter @workspace/api-server run build && node -e \"require('fs').cpSync('artifacts/api-server/dist', 'dist', {recursive: true})\"",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
