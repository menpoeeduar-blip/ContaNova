{
  "version": 2,
  "outputDirectory": "public",
  "buildCommand": "node -e \"require('fs').mkdirSync('public', {recursive: true})\"",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
